{{- /*
  chezmoi template for ~/.bashrc (source file: dot_bashrc.tmpl)

  Machine detection happens HERE, at render time (chezmoi apply / diff / cat),
  not when the shell starts. The rendered ~/.bashrc is plain bash.

    gadi  : short hostname starts with "gadi-" (login and compute nodes)
    wsl   : Linux kernel release contains "microsoft"
    ubuntu: anything else (the native laptop)
*/ -}}
{{- $gadi := hasPrefix "gadi-" .chezmoi.hostname -}}
{{- $wsl := and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) -}}
# ~/.bashrc -- managed by chezmoi (dot_bashrc.tmpl). Edit with: chezmoi edit ~/.bashrc
# Rendered for: {{ if $gadi }}NCI Gadi{{ else if $wsl }}laptop (WSL){{ else }}laptop (native Ubuntu){{ end }}
{{- if $gadi }}

# Gadi: global definitions must come first. They define `module`,
# in_login_shell, in_pbs_job, prepend_path, ... used further down.
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi
{{- end }}

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac
{{- if $gadi }}

# ---------------------------------------------------------------------------
# Gadi (interactive shells only)
# ---------------------------------------------------------------------------
prepend_path PATH "$HOME/bin"
prepend_path PATH "$HOME/.local/bin"

if in_login_shell; then
    module load pbs
fi

# Keep caches and temp files off the small home quota
GDATA_BASE="/g/data/tb21/$USER"
export SINGULARITY_CACHEDIR="$GDATA_BASE/pkgs/singularity/cache"
export NXF_HOME="$GDATA_BASE/pkgs/nextflow"
export NXF_SINGULARITY_CACHEDIR="$SINGULARITY_CACHEDIR"
export NXF_CACHE_DIR="$GDATA_BASE/pkgs/nextflow/cache"
export PIXI_CACHE_DIR="$GDATA_BASE/pkgs/pixi/cache"
export RATTLER_CACHE_DIR="$PIXI_CACHE_DIR"
export XDG_CACHE_HOME="$GDATA_BASE/cache"
# Inside PBS jobs (incl. qsub -I) leave TMPDIR alone: PBS points it at jobfs
if ! in_pbs_job; then
    export TMPDIR="$GDATA_BASE/tmp"
    mkdir -p "$TMPDIR" 2>/dev/null
fi

module load use.own

# Deliberately NOT set up here: conda init, pixi on PATH, a default python.
# Interactive shells stay close to the batch-job environment; load tools
# explicitly (module load ..., pixi) when you need them.
{{- end }}

# ---------------------------------------------------------------------------
# Common to all machines
# ---------------------------------------------------------------------------

# don't put duplicate lines or lines starting with space in the history.
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# history length, see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=1000
HISTFILESIZE=2000

# check the window size after each command and update LINES and COLUMNS.
shopt -s checkwinsize

# If set, "**" in a pathname expansion matches all files and subdirectories.
#shopt -s globstar

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# set a fancy prompt (non-color, unless we know we "want" color)
case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac

#force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
        color_prompt=yes
    else
        color_prompt=
    fi
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

# If this is an xterm set the title to user@host:dir
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# some more ls aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Alias definitions.
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# enable programmable completion features
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi
{{- if not $gadi }}

# ---------------------------------------------------------------------------
# Laptop ({{ if $wsl }}WSL{{ else }}native Ubuntu{{ end }})
# ---------------------------------------------------------------------------
alias sshj='ssh -J sarahhp@login.uio.no'

# Add an "alert" alias for long running commands.  Use like so:
#   sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.pixi/bin:$PATH"

# `pass` is only on the laptops
if command -v pass >/dev/null 2>&1; then
    export ANTHROPIC_API_KEY=$(pass anthropic/api-key)
fi
{{- if $wsl }}

# WSL only
#alias open='explorer.exe'
{{- end }}

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$("$HOME/pkgs/miniconda3/bin/conda" 'shell.bash' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "$HOME/pkgs/miniconda3/etc/profile.d/conda.sh" ]; then
        . "$HOME/pkgs/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="$HOME/pkgs/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<
{{- end }}


